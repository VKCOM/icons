{
  "name": "@vkontakte/icons-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn build:icons-sprite && yarn build:icons && yarn build:icons-docs",
    "build:icons": "yarn workspace @vkontakte/icons run icons-build",
    "build:icons-docs": "yarn workspace @vkontakte/icons run docs",
    "build:icons-sprite": "yarn workspace @vkontakte/icons-sprite run build",
    "test": "yarn biome && yarn workspace @vkontakte/icons-scripts test",
    "biome": "biome check",
    "size": "yarn workspace @vkontakte/icons run size",
    "g:npm:version": "cd $INIT_CWD && npm version --no-workspaces-update --no-commit-hooks --no-git-tag-version",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check"
    ],
    "*.{json,md,mdx}": [
      "biome check"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "packageManager": "yarn@4.19.0+sha512.2cb9e5a36f7f11f2bc6ff444830d87368d419e0d83b6a0fb6077d3e6fed0f476c9514dff4ba4d84b049bd34ef32954e550f264ad2fbbfebcba6c89e869530bba"
}
